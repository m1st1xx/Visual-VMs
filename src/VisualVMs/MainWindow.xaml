<Window x:Class="VisualVMs.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Visual VMs" Icon="app.ico" Height="800" Width="1200"
        PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing">
    <Window.Resources>
        <StreamGeometry x:Key="Router">M4,18 A20,8 0 1 0 44,18 A20,8 0 1 0 4,18 Z M4,18 V30 A20,8 0 0 0 44,30 V18 M16,18 H32 M28,15 L32,18 L28,21 M20,15 L16,18 L20,21</StreamGeometry>
        <StreamGeometry x:Key="Server">M12,4 H36 V44 H12 Z M16,12 H32 M16,18 H32 M16,24 H32 M22,38 H26</StreamGeometry>
        <StreamGeometry x:Key="Client">M4,6 H44 V34 H4 Z M20,34 V40 M28,34 V40 M14,42 H34</StreamGeometry>
        <StreamGeometry x:Key="Cloud">M14,38 A9,9 0 0 1 12,20 A12,12 0 0 1 34,16 A9,9 0 0 1 40,38 Z</StreamGeometry>
    </Window.Resources>
    <DockPanel>
        <Menu x:Name="MainMenu" DockPanel.Dock="Top">
            <MenuItem Header="_Файл">
                <MenuItem Header="Новая" Click="New_Click"/>
                <MenuItem Header="Открыть…" Click="Open_Click"/>
                <MenuItem Header="Сохранить" Click="Save_Click"/>
                <MenuItem Header="Сохранить как…" Click="SaveAs_Click"/>
            </MenuItem>
            <MenuItem Header="Обновить (F5)" Click="Refresh_Click"/>
        </Menu>
        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock x:Name="Status"/>
        </StatusBar>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Canvas x:Name="Board" Width="4000" Height="3000" Background="White"
                    MouseLeftButtonDown="Board_MouseLeftButtonDown" MouseMove="Board_MouseMove"
                    MouseLeftButtonUp="Board_MouseLeftButtonUp" MouseRightButtonUp="Board_MouseRightButtonUp"/>
        </ScrollViewer>
    </DockPanel>
</Window>
